# Copy this file to .env and fill in the values.

# --- Database ---------------------------------------------------------------
# Local MongoDB:   mongodb://127.0.0.1:27017/foodbridge
# MongoDB Atlas:   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/foodbridge?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/foodbridge

# --- Security ---------------------------------------------------------------
# Two DIFFERENT long random strings. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string

# --- Server -----------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Where the React app runs (used for CORS and links in emails)
CLIENT_URL=http://localhost:5173

# --- One-time codes (OTP) ---------------------------------------------------
# While developing, OTP codes are printed in the API terminal.
# SHOW_DEV_OTP=true also shows the code on screen, which is handy for demos.
# Always set it to false before putting the app online.
SHOW_DEV_OTP=true

# --- Email (optional) -------------------------------------------------------
# Fill these in to send OTP codes by email (for example a Gmail App Password,
# or a free Brevo/Mailtrap SMTP account). Leave empty to print emails in the terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FoodBridge <no-reply@foodbridge.local>"

# --- Verification documents -------------------------------------------------
# Delete identity documents from disk once an admin approves an account (privacy).
DELETE_DOCS_ON_APPROVAL=true
